rules_version = '2';

// Foto-dokumentacija (sekcija 10).
// NB: cross-service firestore.get() u Storage pravilima nije pouzdan na ovom
// projektu, pa se ne oslanjamo na njega. Upis sme prijavljeni VOZAČ; vezivanje
// fotografije za konkretan zahtev (samo DODELJENI vozač) enforcuje addJobPhoto
// callable (proverava assignedDriverId pre upisa URL-a na zahtev). Download
// URL-ovi (getDownloadURL) su tokenizovani; putanje su nepredvidive.
service firebase.storage {
  match /b/{bucket}/o {
    match /requests/{requestId}/{phase}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role == 'driver'
        && (phase == 'before' || phase == 'after')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
