rules_version = '2';

// Foto-dokumentacija (sekcija 10). Pristup se vezuje za zahtev u Firestore-u:
// piše dodeljeni vozač; čita vlasnik (klijent), dodeljeni vozač i dispečer.
service firebase.storage {
  match /b/{bucket}/o {
    match /requests/{requestId}/{phase}/{fileName} {
      function reqData() {
        return firestore.get(/databases/(default)/documents/requests/$(requestId)).data;
      }

      allow read: if request.auth != null && (
        reqData().clientId == request.auth.uid
        || reqData().assignedDriverId == request.auth.uid
        || request.auth.token.role == 'dispatcher'
      );

      allow write: if request.auth != null
        && (phase == 'before' || phase == 'after')
        && reqData().assignedDriverId == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
